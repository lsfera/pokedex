# Example environment configuration for Pokemon REST API
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=5000

# PokéAPI Configuration
POKEAPI_HOST=pokeapi.co
POKEAPI_SECURE=true

# Fun Translations API Configuration
FUN_TRANSLATIONS_HOST=api.funtranslations.com
FUN_TRANSLATIONS_SECURE=true

# Request Timeout (in seconds, 1-300)
# Controls how long to wait for responses from external APIs
REQUEST_TIMEOUT_SECONDS=30

# Logging Configuration
# Options: trace, debug, info, warn, error
# Can use module-specific filters: pokemon_api=debug,info
RUST_LOG=info
